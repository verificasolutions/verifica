NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
# URL pública canônica (domínio próprio CUSTOMIZADO apenas). Se ausente, o sistema usa a URL
# de produção atual do deploy (Vercel: VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL).
# NÃO deve apontar para um domínio externo desatualizado (ex.: verifica-saas.vercel.app).
# Domínio OFICIAL/CANÔNICO (prioridade máxima; QR/link público usam SEMPRE este domínio).
# Informar SEM /verifica (o basePath é anexado pelo helper). Aceita também com /verifica (sem duplicar).
# Ex.: NEXT_PUBLIC_APP_URL=https://verifica-saas.vercel.app
NEXT_PUBLIC_APP_URL=https://seu-dominio-canonico.com.br
INSTAGRAM_META_APP_ID=your_instagram_meta_app_id
INSTAGRAM_META_APP_SECRET=your_instagram_meta_app_secret
INSTAGRAM_TOKEN_SECRET=generate_a_strong_random_secret_here
RESEND_API_KEY=re_xxx

# Google Maps (server-only, opcional): usa Embed API com a chave; sem chave, embed público.
GOOGLE_MAPS_API_KEY=

# Portal do Cliente
VEHICLE_LOOKUP_PROVIDER=none
CUSTOMER_SESSION_TTL_HOURS=168
